<!-- LocaleGuard project file: console utility that compares localization files.
     Keep TargetFramework set to net10.0 as configured for this workspace. -->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- General build and language settings -->
  <PropertyGroup>
    <!-- Produces a console executable -->
    <OutputType>Exe</OutputType>

    <!-- Target framework for this project -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Enable implicit using directives (C#) -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enable nullable reference types -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ensure locale JSON files are copied to output for easy testing / F5 runs -->
  <ItemGroup>
    <None Update="locales\cy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="locales\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- NuGet dependencies required by the application -->
  <ItemGroup>
    <!-- Spectre.Console is used for pretty terminal output -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
